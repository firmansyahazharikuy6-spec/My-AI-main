{
  "name": "myai-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "worker:dev:test": "npx --yes wrangler@4.152.0 dev --config worker/wrangler.toml --port 8787 --var TURNSTILE_SITE_KEY:1x00000000000000000000AA --var TURNSTILE_SECRET_KEY:1x0000000000000000000000000000000AA",
    "build": "npm run build:web",
    "build:web": "vite build",
    "test": "node --test js/*.test.js worker/*.test.js pages/*.test.js",
    "test:features": "node scripts/e2e-features.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "worker:dev": "npx --yes wrangler@4.152.0 dev --config worker/wrangler.toml",
    "worker:deploy": "npx --yes wrangler@4.152.0 deploy --config worker/wrangler.toml",
    "pages:build": "powershell -NoProfile -ExecutionPolicy Bypass -File pages\\build.ps1",
    "pages:deploy": "npm run pages:build && npx --yes wrangler@4.152.0 pages deploy pages\\dist --project-name myai-v3-firmansyah --branch main",
    "deploy:all": "npm run worker:deploy && npm run pages:deploy",
    "worker:secret": "npx --yes wrangler@4.152.0 secret put --config worker/wrangler.toml",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "npm run build:web && cap sync && node scripts/configure-native.mjs",
    "icons:generate": "node scripts/generate-mobile-icons.mjs",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@mlc-ai/web-llm": "0.2.86",
    "firebase": "^11.2.0",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "docx": "9.5.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "jszip": "3.10.1",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.4.168",
    "pngjs": "7.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "xlsx-js-style": "1.2.0"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
